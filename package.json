{
  "name": "hwanseung-log",
  "version": "1.2.2",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.mjs",
    "dev": "node --env-file-if-exists=.env server.mjs",
    "test": "node --test tests/*.test.mjs",
    "build": "node scripts/build.mjs",
    "cf:dev": "wrangler dev --ip 127.0.0.1 --port 8787",
