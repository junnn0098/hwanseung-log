PORT=4173
HOST=127.0.0.1
# 공공데이터포털에서 발급한 디코딩 인증키. 브라우저에는 노출되지 않습니다.
TOUR_API_KEY=
# 발급된 서비스의 최신 명세에 맞춰 변경할 수 있습니다.
TOUR_API_BASE=https://apis.data.go.kr/B551011/KorService2

AIRPORT_API_KEY=
ODSAY_API_KEY=
KAKAO_REST_API_KEY=

# 공개 배포 시 소유한 도메인으로 변경합니다. 프로토콜과 경로는 제외합니다.
DOMAIN=layover.example.com
# 단일 서버 전체의 일일 상한. 제공기관의 승인 한도를 넘기지 마세요.
ODSAY_DAILY_LIMIT=30
KAKAO_DAILY_LIMIT=500
AIRPORT_DAILY_LIMIT=500
TOUR_DAILY_LIMIT=500
# 로컬 실행은 false. compose에서 Caddy 내부 연결에 한해 true로 설정됩니다.
TRUST_PROXY=false
QUOTA_FILE=data/api-usage.json
