{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hwanseung-log",
  "account_id": "5ddd1cbe0f1f1404e1b629d047e1b669",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-09-18",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/healthz"]
  },
  "durable_objects": {
    "bindings": [{"name": "API_GATE", "class_name": "ApiGate"}]
  },
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["ApiGate"]}],
  "vars": {
    "ODSAY_DAILY_LIMIT": "30",
    "KAKAO_DAILY_LIMIT": "500",
    "AIRPORT_DAILY_LIMIT": "500",
    "TOUR_DAILY_LIMIT": "500"
  },
  "observability": {"enabled": false}
}
